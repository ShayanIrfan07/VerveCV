{
  "name": "vervecv",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "corepack pnpm --filter @vervecv/api dev",
    "dev:web": "corepack pnpm --filter @vervecv/web dev",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -b apps/web --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "build": "tsc -b --pretty false && corepack pnpm --filter @vervecv/web build",
    "size:check": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
